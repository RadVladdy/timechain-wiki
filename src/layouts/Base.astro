---
import "../styles/global.css";
const {
  title = "TimechainWiki",
  description = "The Bitcoin encyclopedia — a structured, non-tribal reference.",
  ogType = "website",
  jsonLd = null,
  mdAlternate = null,
} = Astro.props;
const full = title === "TimechainWiki" ? title : `${title} — TimechainWiki`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/brand/banner.png", Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {mdAlternate && <link rel="alternate" type="text/markdown" href={mdAlternate} title="This page as markdown" />}
    <meta property="og:site_name" content="TimechainWiki" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={full} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=2" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <script is:inline>
      (() => {
        try {
          const t = localStorage.getItem("tw-theme");
          if (t) document.documentElement.setAttribute("data-theme", t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="topbar"><div class="wrap"><div class="row">
      <a class="brand" href="/">
        <img class="brandlogo l" src="/logo-light.png" alt="" width="30" height="30" />
        <img class="brandlogo d" src="/logo-dark.png" alt="" width="30" height="30" />
        <span class="wm"><span class="t">Timechain</span><span class="w">Wiki</span></span>
      </a>
      <div class="spacer"></div>
      <button class="chip srch" type="button" id="open-search" aria-label="Search the wiki">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M16.5 16.5 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <span class="srch-t">Search</span><span class="kbd">⌘K</span>
      </button>
      <button class="chip" type="button" id="signin"><span class="dot"></span>Sign in · Nostr / Pubky</button>
      <button class="iconbtn" type="button" id="theme" aria-label="Toggle light/dark">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
      </button>
    </div></div></div>

    <main>
      <slot />
    </main>

    <footer class="foot"><div class="wrap">
      <div class="disc">A free, open Bitcoin encyclopedia — structured navigation, full-text search, and reader annotation with your own keys via Nostr &amp; Pubky.</div>
      <div class="fr">
        <span>TimechainWiki · built on the media-neutral Bitcoin knowledge base</span>
        <span class="mono"><a href="/about" style="color:inherit">about</a> · <a href="/credits" style="color:inherit">credits</a> · rendered from source · CC-BY where the source allows</span>
      </div>
    </div></footer>

    <div class="modal" id="search-modal" hidden>
      <div class="modal-bg" data-close></div>
      <div class="modal-panel" role="dialog" aria-modal="true" aria-label="Search the wiki">
        <div class="search-in">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" style="color:var(--brass)"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M16.5 16.5 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <input id="search-input" type="search" placeholder="Search the encyclopedia…" autocomplete="off" spellcheck="false" />
          <span class="kbd" data-close>esc</span>
        </div>
        <div class="search-results" id="search-results">
          <p class="search-hint">Search titles and full text across every entry.</p>
        </div>
      </div>
    </div>

    <script is:inline>
      // ── ⌘K search (Pagefind) — the index lives in the built site only ──
      (() => {
        const modal = document.getElementById("search-modal");
        const input = document.getElementById("search-input");
        const out = document.getElementById("search-results");
        let pf = null, loaded = false, sel = -1, rows = [];

        async function ensure() {
          if (loaded) return pf;
          loaded = true;
          try {
            pf = await import("/pagefind/pagefind.js");
            await pf.init();
          } catch (e) { pf = null; }
          return pf;
        }
        function open() {
          modal.hidden = false;
          document.body.style.overflow = "hidden";
          requestAnimationFrame(() => input.focus());
          ensure();
        }
        function close() {
          modal.hidden = true;
          document.body.style.overflow = "";
          input.value = ""; sel = -1; rows = [];
          out.innerHTML = '<p class="search-hint">Search titles and full text across every entry.</p>';
        }
        function highlight() {
          rows.forEach((r, i) => r.classList.toggle("on", i === sel));
          if (sel >= 0) rows[sel].scrollIntoView({ block: "nearest" });
        }
        async function run(q) {
          if (!q.trim()) {
            out.innerHTML = '<p class="search-hint">Search titles and full text across every entry.</p>';
            rows = []; sel = -1; return;
          }
          const lib = await ensure();
          if (!lib) { out.innerHTML = '<p class="search-hint">Search runs on the published site — run a full build to index.</p>'; return; }
          const s = await lib.debouncedSearch(q);
          if (!s) return; // superseded by a newer keystroke
          if (!s.results.length) {
            out.innerHTML = '<p class="search-hint">No matches for “' + q.replace(/</g, "&lt;") + '”.</p>';
            rows = []; sel = -1; return;
          }
          const data = await Promise.all(s.results.slice(0, 8).map((r) => r.data()));
          out.innerHTML = data.map((d) =>
            '<a class="sr" href="' + d.url + '"><span class="sr-t">' +
            (d.meta.title || d.url) + '</span><span class="sr-x">' + d.excerpt + "</span></a>"
          ).join("");
          rows = Array.from(out.querySelectorAll(".sr")); sel = -1;
        }

        document.getElementById("open-search")?.addEventListener("click", open);
        document.querySelectorAll(".searchbar, #hero-search").forEach((el) =>
          el.addEventListener("click", open));
        modal.querySelectorAll("[data-close]").forEach((el) => el.addEventListener("click", close));
        input?.addEventListener("input", (e) => run(e.target.value));
        document.addEventListener("keydown", (e) => {
          if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") { e.preventDefault(); modal.hidden ? open() : close(); return; }
          if (modal.hidden) { if (e.key === "/" && !/^(INPUT|TEXTAREA)$/.test(document.activeElement?.tagName)) { e.preventDefault(); open(); } return; }
          if (e.key === "Escape") close();
          else if (e.key === "ArrowDown") { e.preventDefault(); sel = Math.min(sel + 1, rows.length - 1); highlight(); }
          else if (e.key === "ArrowUp") { e.preventDefault(); sel = Math.max(sel - 1, 0); highlight(); }
          else if (e.key === "Enter" && sel >= 0) { e.preventDefault(); rows[sel].click(); }
        });
      })();
    </script>

    <script is:inline>
      const root = document.documentElement;
      document.getElementById("theme")?.addEventListener("click", () => {
        const cur = root.getAttribute("data-theme") || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        const next = cur === "dark" ? "light" : "dark";
        root.setAttribute("data-theme", next);
        try { localStorage.setItem("tw-theme", next); } catch (e) {}
      });
    </script>

    <script>
      // Reader annotation (Phase 3) — select-to-highlight + notes, Nostr sync.
      import { init } from "../lib/annotate.js";
      init();
    </script>
  </body>
</html>
