---
import Base from "../../layouts/Base.astro";
import SectionView from "../../components/SectionView.astro";
import { SECTIONS, findSection } from "../../lib/sections.js";
import titles from "../../lib/wiki-index.json";
import sectionsData from "../../lib/sections-data.json";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("wiki");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const title = titles[entry.id] ?? entry.id;

// A sub-MOC renders as the structured section walk-down (clusters → entries),
// not as raw prose. Everything else renders as an article.
const found = findSection(entry.id);
const secData = sectionsData[entry.id];
const isSection = d.type === "sub-MOC" && found && secData;

let thinkers = [], sources = [], Content = null, toc = [];
if (isSection) {
  const all = await getCollection("wiki");
  const area = found.section.area;
  const nameOf = (e) => titles[e.id] ?? e.id;
  if (area) {
    thinkers = all.filter((e) => e.data.type === "thinker" && e.data.area === area)
      .map((e) => ({ slug: e.id, title: nameOf(e) })).sort((a, b) => a.title.localeCompare(b.title));
    sources = all.filter((e) => e.data.type === "source" && e.data.area === area)
      .map((e) => ({ slug: e.id, title: nameOf(e) })).sort((a, b) => a.title.localeCompare(b.title));
  }
} else {
  const r = await render(entry);
  Content = r.Content;
  // Build an "On this page" table of contents from the article's H2s.
  toc = (r.headings ?? []).filter((h) => h.depth === 2);
}
// Only show the sticky rail when there's enough structure to be worth it.
const showToc = toc.length >= 3;

const section = SECTIONS.find((s) => s.area && s.area === d.area);
const tags = Array.isArray(d.tags) ? d.tags : d.tags ? [d.tags] : [];
const meta = [d.type, d.area, d.level].filter(Boolean);

const pageUrl = new URL(`/wiki/${entry.id}`, Astro.site).href;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": isSection ? "CollectionPage" : "Article",
  headline: title,
  name: title,
  url: pageUrl,
  inLanguage: "en",
  isPartOf: { "@type": "WebSite", name: "TimechainWiki", url: Astro.site?.href },
  ...(section && !isSection ? { articleSection: section.title } : {}),
  ...(tags.length ? { keywords: tags.map(String).join(", ") } : {}),
};
---
<Base
  title={title}
  description={`${title} — from the Bitcoin knowledge base.`}
  ogType={isSection ? "website" : "article"}
  jsonLd={jsonLd}
  mdAlternate={`/wiki/${entry.id}.md`}
>
  {isSection ? (
    <SectionView
      title={title}
      group={found.group}
      scope={found.section.scope}
      summary={secData.summary}
      clusters={secData.clusters}
      thinkers={thinkers}
      sources={sources}
    />
  ) : (
    <Fragment>
    <article class="article" data-pagefind-body>
      <div class:list={["wrap", "art-grid", { "no-rail": !showToc }]}>
        <div class="art-main">
          <nav class="crumbs">
            <a href="/">Home</a> <b>›</b>
            {section && (<><a href={`/wiki/${section.slug}`}>{section.title}</a> <b>›</b> </>)}
            {title}
          </nav>
          <h1 class="dt" data-pagefind-meta="title">{title}</h1>
          {meta.length > 0 && <div class="dmeta" data-pagefind-ignore>{meta.map((m) => <span>{m}</span>)}</div>}
          {tags.length > 0 && <div class="tagrow" data-pagefind-ignore>{tags.map((t) => <span>#{t}</span>)}</div>}
          <div class="prose" data-annotate>
            <Content />
          </div>
        </div>
        {showToc && (
          <aside class="art-rail" data-pagefind-ignore>
            <div class="rail-in">
              <div class="toc-label">On this page</div>
              <nav class="toc">
                {toc.map((h) => <a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a>)}
              </nav>
            </div>
          </aside>
        )}
      </div>
    </article>
    {showToc && (
      <script is:inline>
        (() => {
          const links = Array.from(document.querySelectorAll(".toc a[data-toc]"));
          if (!links.length) return;
          const map = new Map(links.map((a) => [a.getAttribute("data-toc"), a]));
          const heads = links.map((a) => document.getElementById(a.getAttribute("data-toc"))).filter(Boolean);
          let current = null;
          const obs = new IntersectionObserver((ents) => {
            for (const e of ents) if (e.isIntersecting) current = e.target.id;
            if (current) { links.forEach((l) => l.classList.remove("on")); map.get(current)?.classList.add("on"); }
          }, { rootMargin: "-74px 0px -68% 0px", threshold: 0 });
          heads.forEach((h) => obs.observe(h));
        })();
      </script>
    )}
    </Fragment>
  )}
</Base>
