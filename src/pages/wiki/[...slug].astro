---
import Base from "../../layouts/Base.astro";
import { SECTIONS } from "../../lib/sections.js";
import titles from "../../lib/wiki-index.json";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("wiki");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const title = titles[entry.id] ?? entry.id;
const section = SECTIONS.find((s) => s.area && s.area === d.area);
const tags = Array.isArray(d.tags) ? d.tags : d.tags ? [d.tags] : [];
const meta = [d.type, d.area, d.level].filter(Boolean);
---
<Base title={title} description={`${title} — from the Bitcoin knowledge base.`}>
  <article class="article"><div class="wrap">
    <nav class="crumbs">
      <a href="/">Home</a> <b>›</b>
      {section && (<><a href={`/wiki/${section.slug}`}>{section.title}</a> <b>›</b> </>)}
      {title}
    </nav>
    <h1 class="dt">{title}</h1>
    {meta.length > 0 && <div class="dmeta">{meta.map((m) => <span>{m}</span>)}</div>}
    {tags.length > 0 && <div class="tagrow">{tags.map((t) => <span>#{t}</span>)}</div>}
    <div class="prose">
      <Content />
    </div>
  </div></article>
</Base>
