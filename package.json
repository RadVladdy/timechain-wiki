{
  "name": "timechain-wiki",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync": "python3 sync-kb.py && node scripts/gen-nav-rank.mjs",
    "dev": "astro dev",
    "build": "npm run sync && astro build && pagefind --site dist",
    "preview": "astro preview",
    "deploy": "npm run build && bash scripts/deploy.sh",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/sitemap": "^3.7.4",
    "@synonymdev/pubky": "^0.10.0",
    "astro": "^7.4.1",
    "nostr-tools": "^2.23.12",
    "qrcode-generator": "^2.0.4",
    "remark-wiki-link": "^2.0.1"
  },
  "devDependencies": {
    "pagefind": "^1.5.2"
  }
}
