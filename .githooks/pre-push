#!/usr/bin/env bash
# Pre-push gate. Runs every check-*.py in scripts/ and refuses the push if any fails.
#
# This hook is TRACKED (core.hooksPath=.githooks) so it survives a fresh clone.
# An untracked .git/hooks/ hook exists only on the box that wrote it, which is how
# a gate quietly stops existing.
#
# What this gate does NOT prove: that a page works. It reads source and the last
# build on disk. A missing import inside a client <script> and an author `display:`
# beating [hidden] both build green and fail only in a browser. Drive the page.
#
# It reads git's ref-update lines on stdin to work out the exact commits this push
# would publish, and exports them as BK_PUSH_COMMITS for check-commit-messages.py.
# The hook is the only place that knows the remote's current sha, so the range has
# to be computed here rather than guessed by the script.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

ZERO=0000000000000000000000000000000000000000
push_commits=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue          # deleting a ref publishes nothing
  if [ "$remote_sha" = "$ZERO" ]; then
    # New remote branch: judge it on commits that are not already on some remote,
    # not on everything reachable — otherwise a new branch re-litigates all history.
    range=$(git rev-list "$local_sha" --not --remotes)
  else
    range=$(git rev-list "$remote_sha..$local_sha")
  fi
  push_commits="$push_commits $range"
done
export BK_PUSH_COMMITS="$push_commits"

# The gates every repo carrying this hook must run, NAMED rather than discovered.
# The glob below finds the site's own checks; these two are portfolio-wide and are
# asserted by name because a glob cannot tell "this repo runs no checks" from "the
# checks are gone" — a discovery mechanism has nowhere to express deliberate
# emptiness. Measured before this list existed, driving this hook on stdin exactly
# as git does, with real findings planted:
#   • no scripts/check-*.py at all  -> "all checks clean", exit 0, a home path
#     sitting in the tree unread
#   • check-commit-messages.py alone removed -> "all checks clean", exit 0, with a
#     listed identifier in a commit message the push was about to publish. Nothing
#     else reads history, so removing that one file removes the whole surface.
#   • check-pseudonymity.py alone removed -> non-zero, but only by accident:
#     check-commit-messages.py shells out to it and reports the failure as a
#     missing identifier list. An accidental tripwire with a misleading message is
#     not an assertion, and it disappears the moment either file moves.
# Checker counts already differ across the repos carrying this hook (8/3/3/3/2/2),
# so a count is not assertable here; a named floor is.
REQUIRED_CHECKS=(
  scripts/check-pseudonymity.py     # content + built output
  scripts/check-commit-messages.py  # history — the surface nothing else reads
)

shopt -s nullglob
checks=(scripts/check-*.py)

missing=()
for want in "${REQUIRED_CHECKS[@]}"; do
  [ -f "$want" ] || missing+=("$want")
done

if [ ${#checks[@]} -eq 0 ]; then
  echo "!! PUSH BLOCKED — scripts/check-*.py matched NOTHING, so this gate ran zero"
  echo "   checks. It used to print 'all checks clean' here, which is a clean exit"
  echo "   from a gate that inspected none of the public surface."
  exit 1
fi

if [ ${#missing[@]} -ne 0 ]; then
  echo "!! PUSH BLOCKED — a portfolio-wide gate is missing from this repo:"
  for m in "${missing[@]}"; do echo "     ✗ $m"; done
  echo "   Standard: vault 40-Projects/_Standards-Projects.md § 'How every site is"
  echo "   managed' — every repo runs check-pseudonymity.py plus"
  echo "   check-commit-messages.py plus its own set. Restore it from a sibling repo;"
  echo "   the shared body is byte-identical and only the config block differs."
  exit 1
fi

fail=0
ran=0
for check in "${checks[@]}"; do
  echo "── $check"
  ran=$((ran + 1))
  if ! python3 "$check"; then fail=1; fi
done

if [ "$fail" -ne 0 ]; then
  echo
  echo "!! PUSH BLOCKED — a check above failed."
  echo "   Override only with a reason you would write down: git push --no-verify"
  exit 1
fi
# States what ran, not merely that nothing objected: a pass that names no number
# reads identically whether it ran eight checks or none.
echo "── pre-push: $ran check(s) clean"
